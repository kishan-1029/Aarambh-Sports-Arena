# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# NEVER commit .env file with real credentials!
# ============================================

# ============ APP ============
APP_NAME=Arambh Sports Arena
NODE_ENV=development
PORT=7002
LOG_LEVEL=info
CLUB_TIMEZONE=Asia/Kolkata

APP_URL_ADMIN=http://localhost:5173
APP_URL_WEBSITE=http://localhost:3000

# ============ DATABASE ============
# Prefer MONGODB_URI; DATABASE is accepted as an alias (ADR-0003). Placeholders only.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/odoo2026?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/odoo2026?retryWrites=true&w=majority"
DATABASE="mongodb+srv://username:password@cluster.mongodb.net/odoo2026?retryWrites=true&w=majority"

# ============ API CONFIGURATION ============
REACT_APP_API_URL="http://localhost:7002"

# ============ SESSION (admin cookie auth — ADR-0002) ============
SESSION_SECRET="REPLACE_WITH_STRONG_SESSION_SECRET"

# ============ JWT (mobile/MCP later; optional in Phase 1) ============
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ADMIN_JWT_SECRET_KEY="REPLACE_WITH_STRONG_SECRET_KEY_AT_LEAST_256_CHARS"
EMPLOYEE_JWT_SECRET_KEY="REPLACE_WITH_DIFFERENT_STRONG_SECRET_KEY"
JWT_EXPIRY=7d

# ============ PAYMENTS ============
PAYMENTS_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ============ CORS ============
# Comma-separated list of allowed origins (CORS_ORIGINS or ALLOWED_ORIGINS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# ============ SMTP (optional — email stubbed if unset) ============
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Arambh Sports Arena <no-reply@example.com>"

# ============ RATE LIMITING ============
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX=5

# ============ NOTES ============
# 1. Never commit this file with real credentials
# 2. Use strong, unique passwords for all services
# 3. Rotate secrets periodically
# 4. Keep this file restricted (chmod 600 on Linux)
