{
  "name": "barodaweb-demo-server",
  "version": "1.0.0",
  "description": "Arambh Sports Arena API (Odoo.Server)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "worker:dev": "nodemon src/worker.js",
    "worker": "node src/worker.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:concurrency": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPattern=concurrency",
    "seed:demo": "node src/seed/index.js",
    "seed:demo:reset": "node src/seed/index.js --reset",
    "db:indexes": "node scripts/db-indexes.js",
    "lint": "eslint . --ext .js --ignore-pattern node_modules --ignore-pattern uploads --ignore-pattern out --ignore-pattern log"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "file-type": "^21.3.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.16",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.9",
    "pdfkit": "^0.20.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.1.3",
    "knip": "^5.74.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1"
  }
}
